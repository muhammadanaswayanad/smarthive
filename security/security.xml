<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- SmartHive Security Groups -->
        <record id="group_smarthive_user" model="res.groups">
            <field name="name">SmartHive User</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="comment">Can view client information and basic operations</field>
        </record>
        
        <record id="group_smarthive_manager" model="res.groups">
            <field name="name">SmartHive Manager</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="implied_ids" eval="[(4, ref('group_smarthive_user'))]"/>
            <field name="comment">Can manage clients, block/unblock, and change payment status</field>
        </record>
        
        <!-- Record Rules -->
        <record id="rule_smarthive_client_user" model="ir.rule">
            <field name="name">SmartHive Client: User Access</field>
            <field name="model_id" ref="model_smarthive_client"/>
            <field name="groups" eval="[(4, ref('group_smarthive_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        
        <record id="rule_smarthive_client_manager" model="ir.rule">
            <field name="name">SmartHive Client: Manager Access</field>
            <field name="model_id" ref="model_smarthive_client"/>
            <field name="groups" eval="[(4, ref('group_smarthive_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        
        <record id="rule_smarthive_status_user" model="ir.rule">
            <field name="name">SmartHive Status: User Access</field>
            <field name="model_id" ref="model_smarthive_client_status"/>
            <field name="groups" eval="[(4, ref('group_smarthive_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        
    </data>
</odoo>