<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Client Status Tree View -->
        <record id="view_smarthive_client_status_tree" model="ir.ui.view">
            <field name="name">smarthive.client.status.tree</field>
            <field name="model">smarthive.client.status</field>
            <field name="arch" type="xml">
                <list string="Client Status Log" create="false" edit="false" default_order="create_date desc">
                    <field name="create_date"/>
                    <field name="client_id"/>
                    <field name="status_type" widget="badge"/>
                    <field name="status" widget="badge" decoration-success="status=='success'" decoration-warning="status=='warning'" decoration-danger="status=='error'" decoration-info="status=='info'"/>
                    <field name="message"/>
                    <field name="user_id"/>
                </list>
            </field>
        </record>
        
        <!-- Client Status Form View -->
        <record id="view_smarthive_client_status_form" model="ir.ui.view">
            <field name="name">smarthive.client.status.form</field>
            <field name="model">smarthive.client.status</field>
            <field name="arch" type="xml">
                <form string="Client Status Entry" create="false" edit="false">
                    <sheet>
                        <group>
                            <group>
                                <field name="client_id"/>
                                <field name="status_type"/>
                                <field name="status"/>
                                <field name="create_date"/>
                                <field name="user_id"/>
                            </group>
                        </group>
                        
                        <group string="Message">
                            <field name="message" nolabel="1"/>
                        </group>
                        
                        <group string="Details" invisible="not details">
                            <field name="details" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Client Status Search View -->
        <record id="view_smarthive_client_status_search" model="ir.ui.view">
            <field name="name">smarthive.client.status.search</field>
            <field name="model">smarthive.client.status</field>
            <field name="arch" type="xml">
                <search string="Search Client Status">
                    <field name="client_id"/>
                    <field name="message"/>
                    <separator/>
                    <filter string="Success" name="success" domain="[('status', '=', 'success')]"/>
                    <filter string="Warning" name="warning" domain="[('status', '=', 'warning')]"/>
                    <filter string="Error" name="error" domain="[('status', '=', 'error')]"/>
                    <filter string="Info" name="info" domain="[('status', '=', 'info')]"/>
                    <separator/>
                    <filter string="Connection" name="connection" domain="[('status_type', '=', 'connection')]"/>
                    <filter string="Payment" name="payment" domain="[('status_type', '=', 'payment')]"/>
                    <filter string="Block/Unblock" name="block" domain="[('status_type', '=', 'block')]"/>
                    <filter string="Warning" name="warning_type" domain="[('status_type', '=', 'warning')]"/>
                    <separator/>
                    <filter string="Today" name="today" domain="[('create_date', '>=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                    <filter string="This Week" name="this_week" domain="[('create_date', '>=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Client" name="group_client" context="{'group_by': 'client_id'}"/>
                        <filter string="Status Type" name="group_status_type" context="{'group_by': 'status_type'}"/>
                        <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                        <filter string="Date" name="group_date" context="{'group_by': 'create_date:day'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- Action for Client Status -->
        <record id="action_smarthive_client_status" model="ir.actions.act_window">
            <field name="name">Client Status Log</field>
            <field name="res_model">smarthive.client.status</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_group_client': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No status logs found
                </p>
                <p>
                    Client status logs will appear here as activities occur
                    with your managed clients.
                </p>
            </field>
        </record>
        
    </data>
</odoo>