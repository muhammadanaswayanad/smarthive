<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Client Management Tree View -->
        <record id="view_smarthive_client_tree" model="ir.ui.view">
            <field name="name">smarthive.client.tree</field>
            <field name="model">smarthive.client</field>
            <field name="arch" type="xml">
                <list string="SmartHive Clients" decoration-danger="is_blocked" decoration-warning="payment_status=='pending'" decoration-muted="not active">
                    <field name="name"/>
                    <field name="client_id"/>
                    <field name="domain"/>
                    <field name="connection_status" widget="badge" decoration-success="connection_status=='online'" decoration-danger="connection_status=='error'" decoration-warning="connection_status=='offline'"/>
                    <field name="payment_status" widget="badge" decoration-success="payment_status=='paid'" decoration-warning="payment_status=='pending'" decoration-danger="payment_status in ['overdue','blocked']"/>
                    <field name="outstanding_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="next_payment_due"/>
                    <field name="last_connection"/>
                    <field name="is_blocked" widget="boolean_toggle"/>
                    <field name="active" widget="boolean_toggle"/>
                    <field name="currency_id" invisible="1"/>
                </list>
            </field>
        </record>
        
        <!-- Client Management Form View -->
        <record id="view_smarthive_client_form" model="ir.ui.view">
            <field name="name">smarthive.client.form</field>
            <field name="model">smarthive.client</field>
            <field name="arch" type="xml">
                <form string="SmartHive Client">
                    <header>
                        <button name="action_check_connection" string="Check Connection" type="object" class="oe_highlight"/>
                        <button name="action_block_client" string="Block Client" type="object" class="btn-danger" invisible="is_blocked" confirm="Are you sure you want to block this client?"/>
                        <button name="action_unblock_client" string="Unblock Client" type="object" class="btn-success" invisible="not is_blocked"/>
                        <button name="action_send_warning" string="Send Warning" type="object" class="btn-warning"/>
                        <button name="action_update_payment_status" string="Update Payment Status" type="object"/>
                        <field name="connection_status" widget="statusbar" statusbar_visible="online,offline,error"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" type="action" name="%(action_smarthive_client_status)d" icon="fa-list-alt" context="{'default_client_id': id}">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text">Status Log</span>
                                </div>
                            </button>
                        </div>
                        
                        <widget name="web_ribbon" title="BLOCKED" bg_color="bg-danger" invisible="not is_blocked"/>
                        <widget name="web_ribbon" title="PAYMENT OVERDUE" bg_color="bg-warning" invisible="payment_status != 'overdue'"/>
                        
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Client Name"/>
                            </h1>
                        </div>
                        
                        <group>
                            <group string="Client Information">
                                <field name="client_id"/>
                                <field name="domain"/>
                                <field name="database_name"/>
                                <field name="active"/>
                                <field name="odoo_version"/>
                                <field name="client_addon_version"/>
                            </group>
                            <group string="Connection &amp; Status">
                                <field name="connection_status"/>
                                <field name="last_connection"/>
                                <field name="is_blocked"/>
                                <field name="block_reason" invisible="not is_blocked"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Payment Information">
                                <group>
                                    <group string="Payment Status">
                                        <field name="payment_status"/>
                                        <field name="outstanding_amount" widget="monetary"/>
                                        <field name="currency_id"/>
                                        <field name="last_payment_date"/>
                                        <field name="next_payment_due"/>
                                    </group>
                                    <group string="Auto-Block Settings">
                                        <field name="auto_block_overdue"/>
                                        <field name="overdue_grace_days" invisible="not auto_block_overdue"/>
                                    </group>
                                </group>
                            </page>
                            
                            <page string="Warning Settings">
                                <group>
                                    <field name="show_warning"/>
                                    <field name="warning_message" invisible="not show_warning"/>
                                </group>
                            </page>
                            
                            <page string="Security">
                                <group>
                                    <field name="api_key" password="True"/>
                                </group>
                            </page>
                            
                            <page string="Notes">
                                <field name="notes" placeholder="Additional notes about this client..."/>
                            </page>
                        </notebook>
                    </sheet>
                    
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        
        <!-- Client Management Search View -->
        <record id="view_smarthive_client_search" model="ir.ui.view">
            <field name="name">smarthive.client.search</field>
            <field name="model">smarthive.client</field>
            <field name="arch" type="xml">
                <search string="Search SmartHive Clients">
                    <field name="name"/>
                    <field name="client_id"/>
                    <field name="domain"/>
                    <separator/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Blocked" name="blocked" domain="[('is_blocked', '=', True)]"/>
                    <filter string="Online" name="online" domain="[('connection_status', '=', 'online')]"/>
                    <filter string="Offline" name="offline" domain="[('connection_status', '=', 'offline')]"/>
                    <separator/>
                    <filter string="Paid" name="paid" domain="[('payment_status', '=', 'paid')]"/>
                    <filter string="Pending Payment" name="pending" domain="[('payment_status', '=', 'pending')]"/>
                    <filter string="Overdue" name="overdue" domain="[('payment_status', '=', 'overdue')]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Connection Status" name="group_connection" context="{'group_by': 'connection_status'}"/>
                        <filter string="Payment Status" name="group_payment" context="{'group_by': 'payment_status'}"/>
                        <filter string="Blocked Status" name="group_blocked" context="{'group_by': 'is_blocked'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- Client Management Kanban View -->
        <record id="view_smarthive_client_kanban" model="ir.ui.view">
            <field name="name">smarthive.client.kanban</field>
            <field name="model">smarthive.client</field>
            <field name="arch" type="xml">
                <kanban string="SmartHive Clients" default_group_by="connection_status">
                    <field name="name"/>
                    <field name="client_id"/>
                    <field name="domain"/>
                    <field name="connection_status"/>
                    <field name="payment_status"/>
                    <field name="is_blocked"/>
                    <field name="outstanding_amount"/>
                    <field name="currency_id"/>
                    <field name="last_connection"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_card oe_kanban_global_click #{record.is_blocked.raw_value ? 'o_kanban_record_has_warning' : ''}">
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="name"/>
                                            </strong>
                                            <div class="o_kanban_record_subtitle text-muted">
                                                <field name="client_id"/>
                                            </div>
                                        </div>
                                        <div class="o_kanban_manage_button_section">
                                            <a class="o_kanban_manage_toggle_button" href="#"><i class="fa fa-ellipsis-v"/></a>
                                        </div>
                                    </div>
                                    
                                    <div class="o_kanban_record_body">
                                        <div class="o_kanban_tags_section">
                                            <span t-if="record.payment_status.raw_value == 'paid'" class="badge badge-success">Paid</span>
                                            <span t-if="record.payment_status.raw_value == 'pending'" class="badge badge-warning">Pending</span>
                                            <span t-if="record.payment_status.raw_value == 'overdue'" class="badge badge-danger">Overdue</span>
                                            <span t-if="record.is_blocked.raw_value" class="badge badge-danger">Blocked</span>
                                        </div>
                                        
                                        <div class="o_kanban_record_bottom">
                                            <div class="oe_kanban_bottom_left">
                                                <span t-if="record.outstanding_amount.raw_value > 0" class="text-danger">
                                                    <field name="outstanding_amount" widget="monetary"/>
                                                </span>
                                            </div>
                                            <div class="oe_kanban_bottom_right">
                                                <small class="text-muted">
                                                    <field name="last_connection" widget="relative"/>
                                                </small>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="o_dropdown_kanban dropdown" groups="smarthive.group_smarthive_manager">
                                        <a class="dropdown-toggle o-no-caret btn" data-toggle="dropdown" href="#" role="button" aria-label="Dropdown menu" title="Dropdown menu">
                                            <span class="fa fa-ellipsis-v"/>
                                        </a>
                                        <div class="dropdown-menu" role="menu">
                                            <a t-if="!record.is_blocked.raw_value" role="menuitem" type="object" name="action_block_client" class="dropdown-item">Block Client</a>
                                            <a t-if="record.is_blocked.raw_value" role="menuitem" type="object" name="action_unblock_client" class="dropdown-item">Unblock Client</a>
                                            <a role="menuitem" type="object" name="action_send_warning" class="dropdown-item">Send Warning</a>
                                            <a role="menuitem" type="object" name="action_check_connection" class="dropdown-item">Check Connection</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        
        <!-- Action for Client Management -->
        <record id="action_smarthive_client" model="ir.actions.act_window">
            <field name="name">Client Management</field>
            <field name="res_model">smarthive.client</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first SmartHive client
                </p>
                <p>
                    Add and manage your remote Odoo client instances from here.
                    You can monitor their connection status, payment information,
                    and manage access control.
                </p>
            </field>
        </record>
        
    </data>
</odoo>