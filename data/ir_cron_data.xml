<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Cron job for checking client connections -->
        <record id="cron_check_client_connections" model="ir.cron">
            <field name="name">SmartHive: Check Client Connections</field>
            <field name="model_id" ref="model_smarthive_client"/>
            <field name="state">code</field>
            <field name="code">model.cron_check_connections()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
            <field name="doall" eval="False"/>
        </record>
        
        <!-- Cron job for checking payment status -->
        <record id="cron_check_payment_status" model="ir.cron">
            <field name="name">SmartHive: Check Payment Status</field>
            <field name="model_id" ref="model_smarthive_client"/>
            <field name="state">code</field>
            <field name="code">model.cron_check_payments()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
            <field name="doall" eval="False"/>
        </record>
        
    </data>
</odoo>